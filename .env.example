# 复制为 .env 后填写。随机密码：python -c "import secrets;print(secrets.token_hex(24))"
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
DEEPSEEK_API_KEY=
# D8–D9：留空 Key 时自动用 Mock harness；填入后自动切换真实 DeepSeek。
# 可选覆盖（默认值已内置，一般无需改）：
# DSH_ADAPTER=auto          # auto | mock | deepseek
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_S=20

# 可选：账号会话有效期（小时，默认 168 = 7 天）。账号/权限本身无需额外环境变量。
# SESSION_TTL_HOURS=168
